# Point these at the TEST Supabase project (see docs/systems-and-accounts.md,
# "The test database"); only Vercel knows the live one.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SITE_URL=http://localhost:3000

# The test project's connection string (Connect, then Session pooler), used by
# `npm run db:migrate`. That script refuses to touch the live project.
TEST_DATABASE_URL=

# Email notifications (see docs/systems-and-accounts.md). Leave these out on
# your Mac: Vercel is the only place that sends notification emails.
# RESEND_API_KEY=
# NOTIFY_TOKEN=
# NOTIFY_FROM=Blocktime <notifications@mail.blocktime.group>
# CRON_SECRET=
